# Copy to `.env` to override. Metro inlines EXPO_PUBLIC_* at bundle time, so a
# change here needs a restart (`npx expo start -c`).
#
# Nothing in this build reaches a network: ENABLE_MOCK_API is on in every
# environment and the default API host is deliberately unroutable.

# development | test | staging | production
EXPO_PUBLIC_APP_ENV=development

# Set when a real backend exists. Until then the mock repositories serve
# everything and this value is unused.
# EXPO_PUBLIC_API_BASE_URL=https://api.cashflow.example/v1

# EXPO_PUBLIC_REQUEST_TIMEOUT_MS=15000
